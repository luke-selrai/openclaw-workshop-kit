#!/usr/bin/env bash
# cloudkit-transcribe — wrap whisper.cpp + ffmpeg behind a single CLI.
#
# Usage:
#   cloudkit-transcribe <audio-file>           # uses default model (base.en)
#   WHISPER_MODEL=small.en cloudkit-transcribe <audio-file>
#
# Accepts any audio format ffmpeg can decode (.oga/.ogg/.mp3/.m4a/.wav/.webm/.opus).
# Prints the transcribed text to stdout. Exits non-zero on any error.

set -euo pipefail

INPUT="${1:?usage: cloudkit-transcribe <audio-file>}"
[[ -r "$INPUT" ]] || { echo "ERROR: cannot read $INPUT" >&2; exit 2; }

MODEL_NAME="${WHISPER_MODEL:-base.en}"
WHISPER_BIN=/opt/whisper.cpp/build/bin/whisper-cli
MODEL_PATH=/opt/whisper.cpp/models/ggml-${MODEL_NAME}.bin

[[ -x "$WHISPER_BIN" ]] || { echo "ERROR: $WHISPER_BIN missing or not executable" >&2; exit 2; }
[[ -f "$MODEL_PATH"  ]] || { echo "ERROR: model $MODEL_PATH missing — install with the voice-transcription skill" >&2; exit 2; }

TMP=$(mktemp -d -t cloudkit-transcribe-XXXXXX)
trap 'rm -rf "$TMP"' EXIT

# Convert to whisper.cpp's preferred format: 16kHz mono WAV.
ffmpeg -loglevel error -y -i "$INPUT" -ar 16000 -ac 1 "$TMP/audio.wav" 2>"$TMP/ff.err" || {
  echo "ERROR: ffmpeg failed on $INPUT:" >&2
  cat "$TMP/ff.err" >&2
  exit 3
}

# Transcribe. --no-timestamps removes the [00:00 --> 00:05] markers; --no-prints
# silences the progress logging. Anything left on stdout is the transcript.
"$WHISPER_BIN" \
  -m "$MODEL_PATH" \
  -f "$TMP/audio.wav" \
  --no-timestamps \
  --no-prints \
  2>/dev/null \
  | sed 's/^[[:space:]]*//; s/[[:space:]]*$//'
