{
  "version": "1.0.0",
  "description": "Defines what gets ported from local Claude Code setup to remote server",
  "include": [
    {
      "label": "Skills",
      "path": "~/.claude/skills",
      "type": "directory",
      "required": false
    },
    {
      "label": "Agents",
      "path": "~/.claude/agents",
      "type": "directory",
      "required": false
    },
    {
      "label": "MCP Config",
      "path": "~/.claude/mcp_config.json",
      "type": "file",
      "required": true
    },
    {
      "label": "Project Memories",
      "path": "~/.claude/projects",
      "type": "directory",
      "required": false
    },
    {
      "label": "CLAUDE.md",
      "path": "~/CLAUDE.md",
      "type": "file",
      "required": true
    },
    {
      "label": "Environment Files",
      "path": "~/.env",
      "type": "file",
      "required": false
    }
  ],
  "exclude": [
    "node_modules",
    ".git",
    "*.log",
    ".DS_Store"
  ],
  "notes": [
    "Supabase and Tailscale configs are optional add-ons — not included by default",
    "Multi-agent framework files are included only if agents folder exists",
    "API keys in .env files transfer as-is — user must verify they are valid on server"
  ]
}
