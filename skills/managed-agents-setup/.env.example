# managed-agents-setup — secret placeholders (names only, never real values)
#
# Copy the names you need into ~/.claude/managed-agents/secrets.env and fill in
# the real values THERE. That file is git-ignored and is sourced by the bridge
# and vault scripts at run time. Never put a real value in this file or commit one.
#
# Framer (unframer) hosted MCP: the project id and secret are embedded in the
# MCP url. mcp-bridge.sh substitutes these two placeholders into the framer
# entry in references/mcp-bridge.json. If either is unset the framer entry is
# skipped (MISSING-TOKEN), never pushed with the placeholder.
FRAMER_MCP_ID=
FRAMER_MCP_SECRET=
