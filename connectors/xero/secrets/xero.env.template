# Xero Connector Credentials
#
# How to get these:
# 1. Go to developer.xero.com
# 2. Click "My Apps" in the top menu
# 3. Click "New App"
# 4. Choose "Custom Connection" as the app type
# 5. Give it a name (e.g. "AI Assistant")
# 6. Accept the terms and click "Create App"
# 7. Copy the "Client ID" below
# 8. Click "Generate a secret" and copy the "Client Secret" below
# 9. Under "Configuration" > "Scopes", add:
#    - accounting.transactions
#    - accounting.contacts
#    - accounting.reports.read
#    - accounting.settings.read

XERO_CLIENT_ID=your_client_id_here
XERO_CLIENT_SECRET=your_client_secret_here
