# Shopify Connector Credentials
#
# How to get these:
# 1. Log into your Shopify admin (your-store.myshopify.com/admin)
# 2. Click "Settings" in the bottom left
# 3. Click "Apps and sales channels"
# 4. Click "Develop apps" at the top
# 5. Click "Create an app" — name it anything (e.g. "AI Assistant")
# 6. Click "Configure Admin API scopes" — select the scopes you need
#    (read_products, write_products, read_orders, read_customers, etc.)
# 7. Click "Install app"
# 8. Copy the "Admin API access token" (starts with shpat_)

# Your Shopify store domain (e.g. my-cool-store.myshopify.com)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Your Admin API access token (starts with shpat_)
SHOPIFY_ACCESS_TOKEN=shpat_your_access_token_here
