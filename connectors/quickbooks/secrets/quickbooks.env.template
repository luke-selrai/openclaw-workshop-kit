# QuickBooks Online Connector Credentials
#
# How to get these:
# 1. Go to developer.intuit.com
# 2. Sign in with your Intuit/QuickBooks account
# 3. Click "My Apps" then "Create an app"
# 4. Choose "QuickBooks Online and Payments"
# 5. Name it "AI Assistant"
# 6. Go to "Keys & credentials"
# 7. Copy the Client ID and Client Secret below

INTUIT_CLIENT_ID=your_client_id_here
INTUIT_CLIENT_SECRET=your_client_secret_here
INTUIT_REDIRECT_URI=http://localhost:3000/callback
INTUIT_ENVIRONMENT=production
