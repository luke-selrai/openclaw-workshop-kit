# Google Chat Connector
#
# Google Chat requires a Google Workspace account (not personal Gmail).
# Authentication is handled via the gws CLI tool — no API keys needed here.
#
# Setup:
# 1. Install gws CLI: npm install -g @googleworkspace/cli
# 2. Set up GCP project: gws auth setup --login
#    OR get client_secret.json from your team lead and save to ~/.config/gws/
# 3. Authenticate: gws auth login -s chat,gmail,calendar,drive
#
# No credentials to paste here — authentication is handled by the gws CLI.
# This file exists for consistency with the connector pattern.

GOOGLE_CHAT_CONFIGURED=false
