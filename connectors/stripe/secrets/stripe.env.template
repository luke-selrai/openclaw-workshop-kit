# Stripe Connector Credentials
#
# How to get this:
# 1. Go to dashboard.stripe.com
# 2. Click "Developers" in the top menu
# 3. Click "API Keys"
# 4. Click "Create restricted key"
# 5. Name it "AI Assistant"
# 6. Set permissions (Read for most things, Write for invoices/payment links)
# 7. Click "Create key" and copy it
#
# IMPORTANT: Use a Restricted Key (starts with rk_), NOT your Secret Key (sk_)
# Restricted keys limit what the AI can do — much safer.

STRIPE_API_KEY=rk_live_your_restricted_key_here
